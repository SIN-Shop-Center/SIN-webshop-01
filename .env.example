# Purpose: Environment variable template for Next.js 16 storefront
# Docs: AGENTS.md
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real secrets.
#
# ===== Supabase (self-hosted via Cloudflare Tunnel) =====
# WICHTIG: https, KEIN Port. Port 8006 ist NUR die interne Tunnel-Ingress-Adresse.
# Direct/private Postgres URL used only by pnpm db:migrate*.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=https://supabase.delqhi.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUR serverseitig verwenden. NIEMALS NEXT_PUBLIC_-Prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Stripe =====
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== App =====
SITE_URL=https://shopsin.delqhi.com
NEXT_PUBLIC_APP_URL=https://shopsin.delqhi.com
# Optional legal/tax fields. Populate only with verified business data.
NEXT_PUBLIC_LEGAL_PHONE=
NEXT_PUBLIC_VAT_ID=
# Set true in production after validating the CSP report-only logs.
CSP_ENFORCE=false

# ===== Resend (Email) =====
RESEND_API_KEY=
RESEND_FROM_EMAIL="ShopSIN <bestellungen@delqhi.com>"

# ===== CJ Dropshipping =====
CJ_EMAIL=
CJ_API_KEY=
CJ_PRICE_MULTIPLIER=2.5

# CJ webhook shared secret (set in CJ Dashboard webhook settings)
CJ_WEBHOOK_SECRET=

# ===== TikTok Shop =====
TIKTOK_SERVICE_ID=
TIKTOK_AUTHORIZATION_URL=https://services.tiktokshop.com/open/authorize
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# Runtime OAuth tokens/shop metadata are persisted in Supabase tiktok_auth.
TIKTOK_PRICE_MULTIPLIER=2.8
TIKTOK_CURRENCY=EUR
TIKTOK_SHIPPING_PROVIDER_ID=

# ===== Cron =====
CRON_SECRET=

# ===== Pricing =====
FX_RATE_USD_EUR=0.92

# ===== Monitoring =====
KUMA_PUSH_CJ_SYNC=
KUMA_PUSH_CJ_FULFILLMENT=
KUMA_PUSH_FX_UPDATE=
KUMA_PUSH_TIKTOK_ORDERS=
# Alert rate-limit state dir (default /tmp — use /var/lib/alerts for persistence)
ALERT_STATE_DIR=
ALERT_RATE_LIMIT_SECS=900

# ===== Autonomous Commerce Control Plane =====
# Local queue worker. The worker polls public.queue_jobs and runs allowlisted stages.
COMMERCE_WORKER_POLL_MS=15000
SHOP_MIN_DATA_QUALITY=80
SHOP_PUBLISH_LIMIT=20
TIKTOK_MIN_DATA_QUALITY=80
# Safe default: create a TikTok Shop draft for seller review. Set LISTING only
# after the development-shop tests and category/GPSR attributes are complete.
TIKTOK_SAVE_MODE=AS_DRAFT

# TikTok Content Posting API. Disabled by default. When enabled, approved local
# OpenMontage videos are uploaded to the authorized user's TikTok inbox as drafts.
TIKTOK_CONTENT_UPLOAD_ENABLED=false
TIKTOK_CONTENT_USER_ACCESS_TOKEN=
TIKTOK_CONTENT_DAILY_LIMIT=5

# Real trend sources. Google Trends RSS for Germany is enabled by default.
GOOGLE_TRENDS_RSS_URL=https://trends.google.com/trending/rss?geo=DE
TREND_MAX_CANDIDATES=60
# Optional JSON array, e.g. [{"name":"approved-feed","url":"https://...","weight":1.1}]
TREND_SOURCE_ENDPOINTS_JSON=
# Optional local JSON produced by an approved browser scraper.
TREND_BROWSER_OUTPUT=

# Daily CJ selection policy.
CJ_TREND_KEYWORD_LIMIT=12
CJ_PRODUCTS_PER_KEYWORD=3
CJ_DAILY_PRODUCT_LIMIT=10
MIN_TREND_SCORE=45

# Product research. Configure exactly one provider.
# OpenAI Responses API with web_search and strict structured output:
OPENAI_API_KEY=
OPENAI_ENRICHMENT_MODEL=gpt-5
# Or a compatible internal HTTPS service:
PRODUCT_RESEARCH_ENDPOINT=
PRODUCT_RESEARCH_TOKEN=
ENRICHMENT_PRODUCT_LIMIT=10

# Local OpenMontage handoff.
OPENMONTAGE_ROOT=/Users/jeremy/dev/OpenMontage
CREATIVE_PRODUCT_LIMIT=10
# Fixed command array. Placeholders: {project_id}, {project_path},
# {brief_path}, {openmontage_root}. The bundled wrapper uses `codex exec`, stays
# inside OpenMontage and exits without model usage while a human gate is open.
OPENMONTAGE_AGENT_COMMAND_JSON=["/bin/zsh","/Users/jeremy/dev/SIN-webshop-01/deploy/openmontage/run-product-ugc-codex.sh","{project_id}","{brief_path}"]

# Social review queue. No automatic likes, follows, comments or DMs.
SOCIAL_DRAFT_CHANNELS=tiktok,instagram,pinterest
SOCIAL_DRAFT_DAILY_LIMIT=20

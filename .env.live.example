# ShopSIN production environment template
# Copy to a secret-managed runtime environment. Never commit real values.

# ===== Storefront =====
SITE_URL=https://shopsin.delqhi.com
NEXT_PUBLIC_APP_URL=https://shopsin.delqhi.com
NEXT_PUBLIC_LEGAL_PHONE=
NEXT_PUBLIC_VAT_ID=
CSP_ENFORCE=true

# ===== Supabase (self-hosted via HTTPS Cloudflare Tunnel; never add port 8006) =====
# DATABASE_URL is release/migration-only and must point to the private Postgres endpoint.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_PRIVATE_DB_HOST:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://supabase.delqhi.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ===== Stripe production checkout =====
STRIPE_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===== Transactional email =====
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL="ShopSIN <bestellungen@YOUR_DOMAIN>"
RESEND_WEBHOOK_SECRET=whsec_xxx

# ===== CJ Dropshipping =====
CJ_EMAIL=YOUR_CJ_ACCOUNT_EMAIL
CJ_API_KEY=YOUR_CJ_API_KEY
CJ_WEBHOOK_SECRET=CHANGE_ME_CJ_WEBHOOK_SECRET
CJ_PRICE_MULTIPLIER=2.5

# ===== Authenticated cron endpoints =====
CRON_SECRET=CHANGE_ME_LONG_RANDOM_CRON_SECRET

# ===== Safe marketplace defaults =====
TIKTOK_SAVE_MODE=AS_DRAFT
TIKTOK_CONTENT_UPLOAD_ENABLED=false
TIKTOK_SERVICE_ID=
TIKTOK_AUTHORIZATION_URL=https://services.tiktokshop.com/open/authorize
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SHOP_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_CONTENT_USER_ACCESS_TOKEN=
TIKTOK_PRICE_MULTIPLIER=2.8
TIKTOK_CURRENCY=EUR

# ===== Commerce control plane =====
COMMERCE_WORKER_POLL_MS=15000
SHOP_MIN_DATA_QUALITY=80
SHOP_PUBLISH_LIMIT=20
TIKTOK_MIN_DATA_QUALITY=80
GOOGLE_TRENDS_RSS_URL=https://trends.google.com/trending/rss?geo=DE
TREND_MAX_CANDIDATES=60
TREND_SOURCE_ENDPOINTS_JSON=
TREND_BROWSER_OUTPUT=
CJ_TREND_KEYWORD_LIMIT=12
CJ_PRODUCTS_PER_KEYWORD=3
CJ_DAILY_PRODUCT_LIMIT=10
MIN_TREND_SCORE=45

# Configure OpenAI research or PRODUCT_RESEARCH_ENDPOINT.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_ENRICHMENT_MODEL=gpt-5
PRODUCT_RESEARCH_ENDPOINT=
PRODUCT_RESEARCH_TOKEN=
ENRICHMENT_PRODUCT_LIMIT=10

# ===== Local OpenMontage handoff =====
OPENMONTAGE_ROOT=/Users/jeremy/dev/OpenMontage
OPENMONTAGE_AGENT_COMMAND_JSON=["/bin/zsh","/Users/jeremy/dev/SIN-webshop-01/deploy/openmontage/run-product-ugc-codex.sh","{project_id}","{brief_path}"]
CREATIVE_PRODUCT_LIMIT=10

# ===== Social review queue (drafts only) =====
SOCIAL_DRAFT_CHANNELS=tiktok,instagram,pinterest
SOCIAL_DRAFT_DAILY_LIMIT=20

# ===== Monitoring / go-live smoke =====
SMOKE_BASE_URL=https://shopsin.delqhi.com
KUMA_PUSH_CJ_SYNC=
KUMA_PUSH_CJ_FULFILLMENT=
KUMA_PUSH_FX_UPDATE=
KUMA_PUSH_TIKTOK_ORDERS=

# Copy to .env.test.local only when using an isolated remote test project.
# The default local harness discovers these values without writing secrets.
TEST_SUPABASE_URL=https://your-isolated-test-project.example
TEST_SUPABASE_SERVICE_ROLE_KEY=
E2E_BASE_URL=http://127.0.0.1:4173
E2E_TEST_DATABASE_URL=postgresql://test-user:test-password@127.0.0.1:54322/postgres
ALLOW_DESTRUCTIVE_INTEGRATION_TESTS=false
ALLOW_DESTRUCTIVE_E2E_TESTS=false
E2E_STRIPE_TEST_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

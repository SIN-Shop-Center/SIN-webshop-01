{
  "name": "sin-webshop-nextjs",
  "private": true,
  "version": "1.1.0",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "prebuild": "node tooling/scripts/ensure-supported-node.mjs",
    "pretypecheck": "node tooling/scripts/ensure-supported-node.mjs",
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "start": "next start",
    "pipeline:verify": "node tooling/scripts/pipeline/verify-setup.mjs",
    "pipeline:worker": "node tooling/scripts/pipeline/commerce-worker.mjs",
    "pipeline:once": "node tooling/scripts/pipeline/commerce-worker.mjs --once",
    "pipeline:enqueue-daily": "node tooling/scripts/pipeline/enqueue-daily.mjs",
    "pipeline:trends": "node tooling/scripts/pipeline/trend-intelligence.mjs",
    "pipeline:cj-top10": "node tooling/scripts/pipeline/select-top-cj-products.mjs",
    "pipeline:enrich": "node tooling/scripts/pipeline/enrich-products.mjs",
    "pipeline:creative": "node tooling/scripts/pipeline/openmontage-shop-bridge.mjs",
    "pipeline:publish": "node tooling/scripts/pipeline/publish-approved-products.mjs",
    "pipeline:tiktok-video-drafts": "node tooling/scripts/pipeline/upload-approved-tiktok-videos.mjs",
    "pipeline:social-drafts": "node tooling/scripts/pipeline/prepare-social-drafts.mjs",
    "db:migrate": "node tooling/scripts/db-migrate.mjs",
    "db:migrate:status": "node tooling/scripts/db-migrate.mjs --status",
    "db:migrate:baseline": "node tooling/scripts/db-migrate.mjs --baseline",
    "db:local:start": "supabase start --workdir platform/infra --exclude studio,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:local:stop": "supabase stop --workdir platform/infra",
    "db:local:reset": "supabase db reset --local --workdir platform/infra",
    "db:types:generate": "node tooling/scripts/generate-database-types.mjs",
    "db:types:check": "node tooling/scripts/generate-database-types.mjs --check",
    "seed": "node tooling/scripts/supabase/seed-products.mjs",
    "seed:dev": "node tooling/scripts/supabase/seed-products.mjs --dev",
    "test": "node tooling/scripts/ensure-supported-node.mjs && pnpm run check:governance:ci && node --experimental-strip-types --no-warnings --test tooling/scripts/lib/cli-env.test.mjs tooling/scripts/lib/local-supabase-env.test.mjs tooling/scripts/lib/google-api.test.mjs tooling/scripts/lib/web-production-env.test.mjs tooling/scripts/governance-doc-sync.test.mjs tooling/scripts/project-ssot-doc-sync.test.mjs tooling/scripts/google-secret-sync.test.mjs tooling/scripts/sin-a2a-doc-sync.test.mjs tooling/scripts/check-governance-preflight.test.mjs tooling/scripts/storefront-legal-sync.test.mjs tooling/scripts/storefront-runtime-contract.test.mjs tooling/scripts/guard-baseline-validate.test.mjs",
    "test:unit": "vitest run tooling/tests/unit",
    "test:integration": "node tooling/scripts/run-integration.mjs",
    "test:integration:safe": "vitest run tooling/tests/integration",
    "test:quality": "pnpm test && pnpm test:unit && pnpm test:integration",
    "test:e2e": "node tooling/scripts/run-e2e.mjs",
    "test:e2e:dev": "node tooling/scripts/run-e2e.mjs",
    "test:e2e:prod": "E2E_USE_PRODUCTION=true node tooling/scripts/run-e2e.mjs",
    "test:e2e:chromium": "node tooling/scripts/run-e2e.mjs --project=chromium",
    "test:e2e:mobile": "node tooling/scripts/run-e2e.mjs --project=mobile",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check:governance": "node tooling/scripts/check-governance-preflight.mjs",
    "check:governance:ci": "CI=true node tooling/scripts/check-governance-preflight.mjs",
    "check:structure": "node tooling/scripts/check-repository-structure.mjs",
    "guard:lines": "node tooling/scripts/guard-lines.mjs",
    "guard:baseline:validate": "node tooling/scripts/guard-baseline-validate.mjs",
    "guard:baseline": "pnpm run guard:baseline:validate",
    "guard:complexity": "node tooling/scripts/guard-complexity.mjs",
    "check:migrations": "node tooling/scripts/migration-audit.mjs",
    "check:fallbacks": "node tooling/scripts/ensure-supported-node.mjs && node tooling/scripts/check-prod-fallbacks.mjs",
    "check:routes": "node tooling/scripts/check-web-routes.mjs",
    "check:browser-automator": "node tooling/scripts/check-browser-automator-py.mjs",
    "check:web:runtime": "node tooling/scripts/ensure-supported-node.mjs && WEB_RUNTIME_AUTO_STUB_API=true node tooling/scripts/check-web-runtime.mjs",
    "check:web:runtime:lenient": "node tooling/scripts/ensure-supported-node.mjs && WEB_RUNTIME_REQUIRE_HEALTHY_API=false node tooling/scripts/check-web-runtime.mjs",
    "check:web:runtime:strict": "node tooling/scripts/ensure-supported-node.mjs && WEB_RUNTIME_REQUIRE_HEALTHY_API=true node tooling/scripts/check-web-runtime.mjs",
    "check:env:template": "node tooling/scripts/ensure-supported-node.mjs && node tooling/scripts/check-live-env-template.mjs",
    "check:env:live": "node tooling/scripts/ensure-supported-node.mjs && node tooling/scripts/check-live-env.mjs",
    "sync:gdoc:browser-governance": "node tooling/scripts/push-browser-governance-to-gdoc.mjs",
    "sync:gdoc:project-ssot": "node tooling/scripts/sync-project-ssot-doc.mjs",
    "sync:gdoc:storefront-governance": "node tooling/scripts/push-storefront-governance-to-gdoc.mjs",
    "sync:google:cloudflare-key": "node tooling/scripts/push-cloudflare-key-to-google.mjs",
    "secrets:bootstrap": "bash tooling/scripts/secrets-bootstrap.sh",
    "secrets:decrypt": "bash tooling/scripts/secrets-decrypt.sh",
    "secrets:edit": "bash tooling/scripts/secrets-edit.sh",
    "secrets:pubkey": "bash tooling/scripts/secrets-pubkey.sh",
    "secrets:run": "bash tooling/scripts/secrets-run.sh",
    "spm:agent": "pnpm --filter @simone/spm-a2a start",
    "spm:ctl": "node tooling/scripts/spm-ctl-wrapper.mjs",
    "spm:bootstrap": "pnpm --filter @simone/spm-a2a bootstrap",
    "spm:import:sops": "pnpm --filter @simone/spm-a2a import:sops",
    "spm:mcp": "pnpm --filter @simone/spm-secret-sync-mcp start",
    "spm:mcp:http": "pnpm --filter @simone/spm-secret-sync-mcp start:http",
    "hf:deploy:agent": "node tooling/scripts/deploy-sin-a2a-agent-to-hf.mjs",
    "sin-a2a:scaffold": "node tooling/scripts/scaffold-sin-a2a-agent.mjs",
    "sin-a2a:sync:gdoc": "node tooling/scripts/sync-sin-a2a-agent-to-gdoc.mjs",
    "sin-a2a:install:opencode": "node tooling/scripts/install-opencode-sin-a2a.mjs",
    "smoke:go-live": "node tooling/scripts/ensure-supported-node.mjs && node tooling/scripts/go-live-smoke.mjs",
    "go-live:today": "node tooling/scripts/ensure-supported-node.mjs && pnpm run check:governance && pnpm run check:env:live -- --with-smoke && pnpm run db:migrate:status && pnpm run ci && pnpm run check:web:runtime:strict && pnpm smoke:go-live",
    "ci": "node tooling/scripts/ensure-supported-node.mjs && pnpm run check:governance:ci && pnpm check:structure && pnpm db:types:check && pnpm typecheck && WEB_PRODUCTION_ENV_FALLBACK_URL=https://shopsin.delqhi.com WEB_PRODUCTION_ENV_USE_LOCAL_SUPABASE=true node tooling/scripts/with-web-production-env.mjs pnpm build && pnpm check:fallbacks && pnpm check:web:runtime && pnpm guard:lines && pnpm guard:baseline && pnpm guard:complexity && pnpm check:env:template && pnpm check:migrations && pnpm check:routes && pnpm check:browser-automator && pnpm test:quality"
  },
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.18.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.0",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.12.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "stripe": "^22.2.1",
    "svix": "^1.95.2",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.8",
    "postcss": "^8.5.25",
    "supabase": "2.109.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.115.0"
  }
}
